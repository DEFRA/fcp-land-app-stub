{% extends '_layout.njk' %}

{% block pageTitle %}Edit your business details - {{ serviceName }}{% endblock %}

{% block content %}
  <h1 class="title is-2">Edit your business details</h1>

  {% if cannotUpdate %}
    <div class="notification is-danger">
      <p>We're unable to update your business details in this service.</p>
      <p>Please contact the Rural Payments Agency to update your details.</p>
    </div>
    <a class="button is-light" href="/home">Back to your details</a>
  {% else %}
    {% if updateFailed %}
      <div class="notification is-danger">
        Something went wrong saving your details. Please try again.
      </div>
    {% endif %}

    <form method="post" action="/business-details/edit" novalidate>
      <div class="field">
        <label class="label" for="businessName">Business name</label>
        <div class="control">
          <input class="input {% if errors.businessName %}is-danger{% endif %}" type="text" id="businessName" name="businessName" value="{{ formValues.businessName }}">
        </div>
        {% if errors.businessName %}<p class="help is-danger">{{ errors.businessName.text }}</p>{% endif %}
      </div>

      <h2 class="title is-4 mt-5">Address</h2>

      <div class="field">
        <label class="label" for="line1">Address line 1</label>
        <div class="control">
          <input class="input {% if errors.line1 %}is-danger{% endif %}" type="text" id="line1" name="line1" value="{{ formValues.line1 }}">
        </div>
        {% if errors.line1 %}<p class="help is-danger">{{ errors.line1.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="line2">Address line 2 (optional)</label>
        <div class="control">
          <input class="input {% if errors.line2 %}is-danger{% endif %}" type="text" id="line2" name="line2" value="{{ formValues.line2 }}">
        </div>
        {% if errors.line2 %}<p class="help is-danger">{{ errors.line2.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="line3">Address line 3 (optional)</label>
        <div class="control">
          <input class="input {% if errors.line3 %}is-danger{% endif %}" type="text" id="line3" name="line3" value="{{ formValues.line3 }}">
        </div>
        {% if errors.line3 %}<p class="help is-danger">{{ errors.line3.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="city">Town or city</label>
        <div class="control">
          <input class="input {% if errors.city %}is-danger{% endif %}" type="text" id="city" name="city" value="{{ formValues.city }}">
        </div>
        {% if errors.city %}<p class="help is-danger">{{ errors.city.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="county">County (optional)</label>
        <div class="control">
          <input class="input {% if errors.county %}is-danger{% endif %}" type="text" id="county" name="county" value="{{ formValues.county }}">
        </div>
        {% if errors.county %}<p class="help is-danger">{{ errors.county.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="postalCode">Postcode</label>
        <div class="control">
          <input class="input {% if errors.postalCode %}is-danger{% endif %}" type="text" id="postalCode" name="postalCode" value="{{ formValues.postalCode }}">
        </div>
        {% if errors.postalCode %}<p class="help is-danger">{{ errors.postalCode.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="country">Country</label>
        <div class="control">
          <input class="input {% if errors.country %}is-danger{% endif %}" type="text" id="country" name="country" value="{{ formValues.country }}">
        </div>
        {% if errors.country %}<p class="help is-danger">{{ errors.country.text }}</p>{% endif %}
      </div>

      <h2 class="title is-4 mt-5">Contact details</h2>

      <div class="field">
        <label class="label" for="businessTelephone">Telephone (optional)</label>
        <div class="control">
          <input class="input {% if errors.businessTelephone %}is-danger{% endif %}" type="text" id="businessTelephone" name="businessTelephone" value="{{ formValues.businessTelephone }}">
        </div>
        {% if errors.businessTelephone %}<p class="help is-danger">{{ errors.businessTelephone.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="businessMobile">Mobile (optional)</label>
        <div class="control">
          <input class="input {% if errors.businessMobile %}is-danger{% endif %}" type="text" id="businessMobile" name="businessMobile" value="{{ formValues.businessMobile }}">
        </div>
        {% if errors.businessMobile %}<p class="help is-danger">{{ errors.businessMobile.text }}</p>{% endif %}
      </div>

      <div class="field">
        <label class="label" for="businessEmail">Email address</label>
        <div class="control">
          <input class="input {% if errors.businessEmail %}is-danger{% endif %}" type="text" id="businessEmail" name="businessEmail" value="{{ formValues.businessEmail }}">
        </div>
        {% if errors.businessEmail %}<p class="help is-danger">{{ errors.businessEmail.text }}</p>{% endif %}
      </div>

      <h2 class="title is-4 mt-5">Reference numbers</h2>

      <div class="field">
        <label class="label" for="vatNumber">VAT registration number (optional)</label>
        <div class="control">
          <input class="input {% if errors.vatNumber %}is-danger{% endif %}" type="text" id="vatNumber" name="vatNumber" value="{{ formValues.vatNumber }}">
        </div>
        {% if errors.vatNumber %}<p class="help is-danger">{{ errors.vatNumber.text }}</p>{% endif %}
      </div>

      <div class="buttons mt-5">
        <button class="button is-primary" type="submit">Save changes</button>
        <a class="button is-light" href="/home">Cancel</a>
      </div>
    </form>
  {% endif %}
{% endblock %}
