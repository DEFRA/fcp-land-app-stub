# Copy to .env (gitignored) for local development.
# Loaded by `node --env-file-if-exists=.env`. In deployed environments no .env is
# present, so the flag is a no-op and real platform env vars always win.
# NEVER rely on .env in tests (env is injected via vitest.config.js).

# --- Server ---------------------------------------------------------------
PORT=3000

# --- Redis (session cache) ------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Session cookie -------------------------------------------------------
COOKIE_PASSWORD=this-is-a-secret-that-must-be-at-least-32-characters

# --- Defra Identity -------------------------------------------------------
# Locally these point at fcp-defra-id-stub. In a deployed environment they are
# the values issued to you during Defra Identity onboarding.
DEFRA_ID_WELL_KNOWN_URL=http://localhost:3008/idphub/b2c/b2c_1a_cui_cpdev_signupsigninsfi/.well-known/openid-configuration
DEFRA_ID_CLIENT_ID=land-app
DEFRA_ID_CLIENT_SECRET=land-app-secret
DEFRA_ID_SERVICE_ID=land-app-service
DEFRA_ID_POLICY=b2c_1a_cui_cpdev_signupsigninsfi
DEFRA_ID_REDIRECT_URL=http://localhost:3000/auth/sign-in-oidc
DEFRA_ID_SIGN_OUT_REDIRECT_URL=http://localhost:3000/auth/sign-out-oidc

# --- FCP third party external API ------------------------------------------
# Locally this points at fcp-tp-external-api running on the host. In a deployed
# environment it is the CDP API gateway URL for that service, eg
# https://fcp-tp-external-api.api.ext-test.cdp-int.defra.cloud/graphql
EXTERNAL_API_ENDPOINT=http://localhost:3001/graphql
EXTERNAL_API_TIMEOUT=10000

# --- AWS Cognito (machine-to-machine auth to the external API) ------------
# Leave disabled for local development: fcp-tp-external-api has no auth of its
# own locally. Enable in deployed environments where the API sits behind a
# CDP API Gateway protected by Cognito - see the README for how to request one.
COGNITO_ENABLED=false
# COGNITO_DOMAIN=fcp-tp-external-api-c63f2.auth.eu-west-2.amazoncognito.com
# COGNITO_CLIENT_ID=your-app-client-id
# COGNITO_CLIENT_SECRET=your-app-client-secret
# COGNITO_SCOPE=fcp-tp-external-api-resource-srv/access
